{
  "name": "root",
  "private": true,
  "scripts": {
    "clean": "git clean -Xdf",
    "all": "npm run format && npm run test && npm run build && npm run lint",
    "test": "npm run -ws --if-present test",
    "build": "npm run -ws --if-present build",
    "lint": "biome lint --error-on-warnings && npm run -ws --if-present lint",
    "format": "biome format --write && npm run -ws --if-present format"
  },
  "workspaces": [
    "packages/protoc",
    "packages/protobuf-conformance",
    "packages/scripts"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/node": "^25.0.3",
    "esbuild": "^0.27.2",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
